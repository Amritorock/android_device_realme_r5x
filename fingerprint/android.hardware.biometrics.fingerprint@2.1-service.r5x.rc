service fps_hal.r5x /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.1-service.r5x
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system input uhid
    task_profiles ProcessCapacityHigh MaxPerformance

service fps_hal /vendor/bin/hw/vendor.oppo.hardware.biometrics.fingerprint@2.1-service
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system input uhid
    task_profiles ProcessCapacityHigh MaxPerformance

service vendor.fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.3-service.rbs
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    override
    class late_start
    user system
    group system input uhid
    disabled
    task_profiles ProcessCapacityHigh MaxPerformance

on property:persist.vendor.fingerprint.fp_id=E_520 && property:init.svc.fps_hal=running && property:init.svc.fps_hal.r5x=running
    stop fps_hal
    stop fps_hal.r5x
    start vendor.fps_hal
