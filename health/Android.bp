cc_defaults {
    name: "android.hardware.health-service.r5x-defaults",
    relative_install_path: "hw",
    vintf_fragments: ["android.hardware.health-service.r5x.xml"],
    defaults: [
        "libhealth_aidl_impl_user",
    ],
    static_libs: [
        "libhealth_aidl_impl",
    ],
    local_include_dirs: ["."],
    srcs: ["main.cpp"],
}

cc_binary {
    name: "android.hardware.health-service.r5x",
    vendor: true,
    defaults: ["android.hardware.health-service.r5x-defaults"],
    init_rc: ["android.hardware.health-service.r5x.rc"],
}

cc_binary {
    name: "android.hardware.health-service.r5x_recovery",
    recovery: true,
    defaults: ["android.hardware.health-service.r5x-defaults"],
    init_rc: ["android.hardware.health-service.r5x_recovery.rc"],
}
